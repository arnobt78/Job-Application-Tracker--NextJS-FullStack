# Local runs read the repo-root .env.local first (shared with Next.js), then this
# file for service-only overrides. On Coolify, set these as environment variables
# on both the ai-service and arq-worker containers.

# ── AI Service ───────────────────────────────────────────
# Shared secret that Next.js sends in X-Internal-Secret header.
# Required — every route except /health returns 503 while it is unset.
AI_SERVICE_SECRET=change-me-in-production

# CORS — comma-separated list of allowed Next.js origins
AI_SERVICE_ALLOWED_ORIGINS=http://localhost:3000

# ── LLM providers — free-tier fallback chain (app/llm/registry.py) ──
# Order: Groq → Gemini → OpenRouter (:free) → Hugging Face. Missing key = skipped.
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
HF_TOKEN=your_huggingface_token_here

# Optional, tried after the free chain — leave unset to disable
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=llama3.2
# ANTHROPIC_API_KEY=your_anthropic_api_key_here   # paid

# ── ARQ queue ───────────────────────────────────────────
# Local, non-Docker runs only — docker-compose pins redis://redis:6379
REDIS_URL=redis://localhost:6379
# Next.js base URL the worker calls back (/api/internal/ai-complete)
NEXT_APP_URL=https://your-app.vercel.app
