{
  "name": "job-tracker",
  "version": "0.3.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npx prisma generate && NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "db:seed": "tsx --env-file-if-exists=.env.local prisma/seed.ts",
    "db:inspect": "tsx --env-file-if-exists=.env.local scripts/db-inspect.ts",
    "db:fix-status": "tsx --env-file-if-exists=.env.local scripts/db-fix-status.ts",
    "db:fix-future-dates": "tsx --env-file-if-exists=.env.local scripts/db-fix-future-dates.ts",
    "db:seed-test-user": "tsx --env-file-if-exists=.env.local scripts/seed-test-user-jobs.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@hookform/resolvers": "^3.10.0",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@sentry/nextjs": "^10.76.2",
    "@tanstack/query-async-storage-persister": "^5.104.2",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-query-devtools": "^5.104.2",
    "@tanstack/react-query-persist-client": "^5.104.2",
    "@types/bcryptjs": "^2.4.6",
    "@upstash/redis": "^1.39.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.3",
    "dayjs": "^1.11.23",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.43.0",
    "lucide-react": "^0.511.0",
    "next": "^16.4.0",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.4.299",
    "posthog-js": "^1.438.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.4",
    "remark-gfm": "^4.0.1",
    "resend": "^6.32.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@next/env": "^16.4.0",
    "@playwright/test": "^1.64.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.30",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "^8.5.30",
    "postcss-selector-parser": "^7.1.6",
    "sharp": "^0.35.5",
    "uuid": "^11.1.1",
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2"
    }
  },
  "allowScripts": {
    "@prisma/client": true,
    "@prisma/engines": true,
    "@sentry/cli": true,
    "core-js": true,
    "esbuild": true,
    "prisma": true,
    "unrs-resolver": true
  }
}
